@model IEnumerable<PurchaseApp.Models.PurchaseRequest>

@{
    ViewData["Title"] = "Purchase Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Purchase Requests</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Request</a>
</div>

<div data-auto-refresh>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Amount)</th>
            <th>@Html.DisplayNameFor(model => model.Department)</th>
            <th>@Html.DisplayNameFor(model => model.ProposedSupplier)</th>
            <th>@Html.DisplayNameFor(model => model.ApplicantName)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th>@Html.DisplayNameFor(model => model.PurchaseOrderNumber)</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td class="text-nowrap">@item.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("sl-SI"))</td>
                <td>@Html.DisplayFor(modelItem => item.Department)</td>
                <td>@Html.DisplayFor(modelItem => item.ProposedSupplier)</td>
                <td>@Html.DisplayFor(modelItem => item.ApplicantName)</td>
                <td>
                    <span class="badge request-status" data-status="@item.Status">@item.Status</span>
                    @if (item.Status == "Rejected" && !string.IsNullOrEmpty(item.RejectionReason))
                    {
                        <div class="text-danger small mt-1">
                            <div class="fw-bold">Rejection Reason:</div>
                            <div>@item.RejectionReason</div>
                        </div>
                    }
                </td>
                <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.PurchaseOrderNumber))
                    {
                        <span class="badge bg-info text-dark purchase-order-number">@item.PurchaseOrderNumber</span>
                    }
                    else if (!string.IsNullOrEmpty(item.ApiStatusMessage))
                    {
                        <span class="text-danger small">@item.ApiStatusMessage</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td class="text-end">
                    <div class="d-flex align-items-center justify-content-end gap-1">
                        @if (item.Status == "Draft")
                        {
                            <form asp-action="Submit" asp-route-id="@item.Id" method="post" class="m-0">
                                <button type="submit" class="btn btn-success btn-sm">Submit</button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Ali ste prepričani, da želite izbrisati zahtevek?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Locked</span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

